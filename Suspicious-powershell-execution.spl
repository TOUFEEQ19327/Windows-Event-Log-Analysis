index=windows sourcetype="WinEventLog:Security" EventCode=4688
| where match(process_name, "(?i)powershell.exe|pwsh.exe")
| search CommandLine="-enc" OR CommandLine="-encodedcommand" OR CommandLine="downloadstring" OR CommandLine="iex" OR CommandLine="-nop" OR CommandLine="-w hidden" OR CommandLine="-bypass"
| stats count min(_time) as first_seen max(_time) as last_seen by host, user, parent_process_name, process_name, CommandLine
| eval first_seen=strftime(first_seen, "%Y-%m-%d %H:%M:%S"), last_seen=strftime(last_seen, "%Y-%m-%d %H:%M:%S")
| sort - count
